.ruff_cache/

# Node / Angular
node_modules/
dist/
build/
.angular/
coverage/

# IDE / OS
.DS_Store
Thumbs.db
*.tmp
*.swp
.idea/
.vscode/

# JWT keys (generated locally for dev)
backend/config/keys/*.pem

# Local agent/IDE noise (Speckit skills under .claude/skills are tracked)
.agents/
.claude/settings.local.json
.cursor/

# Heavy / generated local data (not source)
# `database/` SÍ se versiona: sus scripts de migración, siembra y verificación
# contra Pinot real son fuente, y son la única red de seguridad de los cambios
# de esquema. Se excluyen solo los artefactos regenerables de dentro.
database/_respaldos/
e2e/
frontend/chrome/

# Root lock / drafts (not runtime source)
/skills-lock.json
/bocetos-dashboards/
/informestacticos
/flujoscorreguidos

# ETL staging (parquet): artefactos regenerables del pipeline tactico, no código fuente
/ETL/**/*.parquet

# Note: `specs/`, `.specify/` and `docker/` ARE tracked.
# OSRM map binaries stay out via `docker/osrm/.gitignore` (data/*).
