# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
*.log
.env
.env.*
!.env.example
!backend/.env.example
!docker/.env.tactico.example

# Django
*.sqlite3
db.sqlite3
media/
staticfiles/
backend/blob_storage/

# Testing
.pytest_cache/
.coverage
htmlcov/
