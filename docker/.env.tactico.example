# Copiar a docker/.env.tactico (sin versionar) y rellenar con valores de desarrollo reales.
# docker/.env.tactico no se commitea — usar `docker compose --env-file docker/.env.tactico -f docker/docker-compose.tactico.yml up -d`

# ClickHouse
CLICKHOUSE_USER=tactico
CLICKHOUSE_PASSWORD=change-me

# Metastore de Airflow (Postgres interno, no expuesto al host)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change-me
AIRFLOW_POSTGRES_DB=airflow

# Airflow core
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=change-me-fernet-key

# Usuario admin de la UI web de Airflow (creado una sola vez por tactico-airflow-init)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me
